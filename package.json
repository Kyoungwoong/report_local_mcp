{
  "name": "local-devlog-mcp",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:calendar && pnpm build:app",
    "build:server": "tsc -p tsconfig.json",
    "build:calendar": "node scripts/build-calendar.mjs",
    "build:app": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "setup": "tsx src/cli/setup.ts",
    "notion:validate": "tsx src/cli/validate-notion.ts",
    "test:calendar:integration": "RUN_CALENDAR_INTEGRATION=1 vitest run tests/calendar-integration.test.ts",
    "test:calendar:write": "RUN_CALENDAR_INTEGRATION=1 RUN_CALENDAR_WRITE_INTEGRATION=1 vitest run tests/calendar-integration.test.ts",
    "test:notion:integration": "RUN_NOTION_INTEGRATION=1 vitest run tests/notion-integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@notionhq/client": "^5.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.0"
  }
}
